{
  "env": {
    "browser": true,
    "es2022": true
  },
  "extends": [
    "next/core-web-vitals"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "no-trailing-spaces": "off",
    "quotes": "off",
    "semi": "off",
    "indent": "off",
    "space-infix-ops": "off",
    "object-curly-spacing": "off",
    "comma-spacing": "off",
    "keyword-spacing": "off",
    "space-before-function-paren": "off",
    "operator-linebreak": "off",
    "multiline-ternary": "off",
    "no-multiple-empty-lines": "off",
    "eol-last": "off",
    "no-undef": "off",
    "no-prototype-builtins": "off",
    "eqeqeq": "off",
    "no-floating-decimal": "off",
    "no-duplicate-case": "warn",
    "no-case-declarations": "off",
    "no-useless-return": "off",
    "spaced-comment": "off",
    "comma-dangle": "off",
    "no-multi-spaces": "off",
    "arrow-spacing": "off"
  }
}